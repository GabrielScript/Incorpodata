# Banco PostGIS (docker compose)
DATABASE_URL=postgresql://terraiq:terraiq@localhost:5432/terraiq

# Credenciais do container Postgres (lidas pelo docker-compose; defaults de dev).
# Em produção troque a senha e recrie o volume. Mantenha consistente com DATABASE_URL.
POSTGRES_USER=terraiq
POSTGRES_PASSWORD=terraiq
POSTGRES_DB=terraiq

# SRID interno métrico (SIRGAS 2000 / UTM 25S para João Pessoa)
INTERNAL_SRID=31985

# Firecrawl (sites de anúncio blindados) — usado na fase de scrapers
FIRECRAWL_API_KEY=

# Geocoding (Nominatim self-host ou serviço) — opcional
GEOCODER_URL=

# Auth (gere um segredo longo e aleatório em produção)
JWT_SECRET=troque-por-um-segredo-aleatorio-bem-longo
ACCESS_TOKEN_EXPIRE_MINUTES=120
